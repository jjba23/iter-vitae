#!/usr/bin/env sh

# iter-vitae
#
# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

# Commentary:
#
# A small POSIX shell launcher around the Guile application.  It only locates
# the installed modules and resources; option parsing is left to Guile, which
# keeps the user-facing and library interfaces in one place.
#
# The previous version depended on GNU getopt, GNU realpath and `readlink -f',
# so it failed on macOS, the BSDs and minimal containers.  This version uses
# only `cd', `pwd', `dirname' and `exec' from POSIX.

set -eu

# `CDPATH= command` is an environment assignment, not a broken `VAR= value`.
# shellcheck disable=SC1007
script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
# shellcheck disable=SC1007
store_dir=$(CDPATH= cd -P "${script_dir}/.." && pwd)
scheme_sources_dir="${store_dir}/share/guile/site/3.0"
resources_dir="${store_dir}/share/resources"

# A source checkout has the modules in src/ and the assets in resources/.
# Distribution packages place both below share/, which wins when present.
if [ ! -d "${scheme_sources_dir}/iter-vitae" ]; then
  scheme_sources_dir="${store_dir}/src"
fi
if [ ! -d "${resources_dir}" ]; then
  resources_dir="${store_dir}/resources"
fi

red_text='\033[0;31m'
reset_text='\033[0m'

log_error() {
  if [ -z "${1:-}" ]; then
    log_error "log_error was called without a message!"
    return 1
  fi
  printf '%b[error] %s%b\n' "${red_text}" "$1" "${reset_text}" >&2
}

log_info() {
  if [ -z "${1:-}" ]; then
    log_error "log_info was called without a message!"
    return 1
  fi
  printf '%s\n' "$1"
}

show_help() {
  cat "${resources_dir}/help.txt"
}

# Honour --help before requiring a persona, just like the previous launcher.
for argument in "$@"; do
  case "${argument}" in
  -h | --help)
    show_help
    exit 0
    ;;
  --)
    break
    ;;
  esac
done

# Supply the bundled stylesheet directory unless the caller chose one.  Adding
# a default argument is safer than duplicating Guile's option parser here.
has_resources=0
for argument in "$@"; do
  case "${argument}" in
  -r | -r?* | --resources | --resources=*)
    has_resources=1
    ;;
  esac
done
if [ "${has_resources}" -eq 0 ]; then
  set -- --resources "${resources_dir}" "$@"
fi

log_info "-------------------------------------------------"
log_info "Starting Iter Vitae: guile -L ${scheme_sources_dir} $*"

exec guile -L "${scheme_sources_dir}" \
  -c '((@(iter-vitae main) main))' "$@"
