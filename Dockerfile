# syntax=docker/dockerfile:1.7

# iter-vitae
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile guile-devel gcc make autoconf automake libtool \
        pkg-config gawk gnulib-devel gettext-tools findutils \
        libcurl-devel sqlite3-devel guile-json guile-gcrypt \
        guile-fibers tar gzip; \
    zypper clean --all

# Build the Guile libraries openSUSE does not package.  They are
# copied into the runtime with the project, so the image needs no
# extra repository or post-install step.

ADD https://download.savannah.gnu.org/releases/guile-lib/guile-lib-0.2.8.1.tar.gz /tmp/guile-lib.tar.gz
RUN set -eu; \
    mkdir -p "/tmp/guile-lib"; \
    tar xzf "/tmp/guile-lib.tar.gz" -C "/tmp/guile-lib" --strip-components=1; \
    cd "/tmp/guile-lib"; \
    ./configure --prefix=/usr --with-guile-site=yes; \
    make -j"$(nproc)"; \
    make install

COPY src/iter-vitae ./src/iter-vitae
COPY scripts/iter-vitae ./scripts/iter-vitae
COPY resources ./resources

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/iter-vitae"; \
    cp -r "src/iter-vitae/." "$site/iter-vitae/"; \
    install -D -m 0755 "scripts/iter-vitae" "/usr/bin/iter-vitae"; \
    sed -i '1s|^#!/usr/bin/env \(.*\)$|#!/usr/bin/\1|' "/usr/bin/iter-vitae"; \
    sed -i 's|share/resources|share/iter-vitae/resources|g' "/usr/bin/iter-vitae"; \
    install -d "/usr/share/iter-vitae/resources"; \
    cp -r resources/. "/usr/share/iter-vitae/resources/"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="iter-vitae" \
      org.opencontainers.image.description="Resume and curriculum vitae generator written in Guile Scheme" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/iter-vitae" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates \
        bash \
        coreutils; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site /usr/share/guile/site
COPY --from=builder /usr/lib64/guile /usr/lib64/guile
RUN ldconfig
COPY --from=builder /usr/bin/iter-vitae /usr/bin/iter-vitae
COPY --from=builder /usr/share/iter-vitae /usr/share/iter-vitae

ENTRYPOINT ["/usr/bin/iter-vitae"]
