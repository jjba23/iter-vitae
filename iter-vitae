#!/usr/bin/env bash

# iter-vitae - Wrapper script for the Guile Scheme iter-vitae program
#
# This script provides a user-friendly interface to the iter-vitae Guile Scheme
# application, allowing it to be called from the command line like a standard
# executable.

set -euo pipefail

GUILE_CODE_LOCATION="$(dirname "$0")/../share/guile/site/3.0"
GUILE_CODE_FILE="$GUILE_CODE_LOCATION/iter-vitae/main.scm"
RESOURCES_LOCATION="$(dirname "$0")/../share/resources"


show_help() {
  echo "Generate a curriculum vitae from a persona file."
  echo ""
  echo "Usage: $(basename "$0") [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  -l, --locale LOCALE      Specify the locale (e.g., 'en', 'es'). Defaults to 'en'."
  echo "  -o, --output-dir DIRECTORY Specify the output directory for the generated CV."
  echo "  -p, --persona-file FILE    Specify the persona file (required)."
  echo "  -h, --help               Display this help message and exit."
  echo ""
  echo "Examples:"
  echo "  $(basename "$0") --locale es --persona-file ~/Documents/my_cv_data.scm --output-dir ~/Documents/generated_cvs"
}

LOCALE=""
OUTPUT_DIR=""
PERSONA_FILE=""
HELP_REQUESTED=0

PARSED_OPTIONS=$(getopt -n "iter-vitae" -o l:o:p:h --long locale:,output-dir:,persona-file:,help -- "$@")

eval set -- "$PARSED_OPTIONS"

while true; do
  case "$1" in
    -l|--locale)
      LOCALE="$2"
      shift 2
      ;;
    -o|--output-dir)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -p|--persona-file)
      PERSONA_FILE="$2"
      shift 2
      ;;
    -h|--help)
      HELP_REQUESTED=1
      shift
      ;;
    --) 
      shift
      break
      ;;
    *)
      echo "Internal error: unrecognized option '$1'" >&2
      exit 1
      ;;
  esac
done

if [[ "$HELP_REQUESTED" -eq 1 ]]; then
  show_help
  exit 0
fi

if [[ -z "$PERSONA_FILE" ]]; then
  echo "Error: The persona file is required. Use -p or --persona-file." >&2
  show_help
  exit 1
fi

GUILE_CMD_ARGS=(
  "-L" "$GUILE_CODE_LOCATION"
  "-c" "((@(iter-vitae main) main))"
)

[[ -n "$LOCALE" ]] && GUILE_CMD_ARGS+=("--locale" "$LOCALE")
[[ -n "$OUTPUT_DIR" ]] && GUILE_CMD_ARGS+=("--output-dir" "$OUTPUT_DIR")

GUILE_CMD_ARGS+=("--persona-file" "$PERSONA_FILE")
GUILE_CMD_ARGS+=("--resources-dir" "$RESOURCES_LOCATION")

echo "Running Guile command: guile ${GUILE_CMD_ARGS[*]}"
exec guile "${GUILE_CMD_ARGS[@]}"
