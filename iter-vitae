#!/usr/bin/env bash

# iter-vitae - Wrapper script for the Guile Scheme iter-vitae program
#
# This script provides a user-friendly interface to the iter-vitae Guile Scheme
# application, allowing it to be called from the command line like a standard
# executable.

set -euo pipefail

GUILE_CODE_LOCATION="$(dirname "$0")/../share/guile/site/3.0"
GUILE_CODE_FILE="$GUILE_CODE_LOCATION/iter-vitae/main.scm"
RESOURCES_LOCATION="$(dirname "$0")/../share/resources"

show_help() {
  echo "Generate a curriculum vitae from a persona file."
  echo ""
  echo "Options:"
  echo "  -l, --locale LOCALE       Specify the locale (e.g., 'en', 'es'). Defaults to 'en'."
  echo "  -o, --output-dir DIRECTORY Specify the output directory for the generated CV."
  echo "  -p, --persona-file FILE   Specify the persona file (required)."
  echo "  -h, --help                Display this help message and exit."
  echo ""
  echo "Examples:"
  echo "  $(basename "$0") --locale es --persona-file ~/Documents/my_cv_data.scm --output-dir ~/Documents/generated_cvs"
}

if ! command -v guile &> /dev/null; then
  echo "Error: Guile is not installed or not found in your PATH." >&2
  echo "Please install Guile to run this script." >&2
  exit 1
fi

if [[ ! -f "$GUILE_CODE_FILE" ]]; then
  echo "Error: Guile source file '$GUILE_CODE_FILE' not found." >&2
  echo "Please ensure '$GUILE_CODE_FILE' is accessible at that path." >&2
  exit 1
fi


LOCALE_ARG=""
PERSONA_FILE_ARG=""
OUTPUT_DIR_ARG=""
HELP_FLAG=0

while (( "$#" )); do
  case "$1" in
    -l|--locale)
      if [[ -n "$2" && "$2" != -* ]]; then
        LOCALE_ARG="--locale $2"
        shift 2
      else
        echo "Error: Argument for $1 is missing." >&2
        show_help
        exit 1
      fi
      ;;
    -o|--output-dir) 
      if [[ -n "$2" && "$2" != -* ]]; then
        OUTPUT_DIR_ARG="--output-dir $2"
        shift 2
      else
        echo "Error: Argument for $1 is missing." >&2
        show_help
        exit 1
      fi
      ;;
    -p|--persona-file)
      if [[ -n "$2" && "$2" != -* ]]; then
        PERSONA_FILE_ARG="--persona-file $2"
        shift 2
      else
        echo "Error: Argument for $1 is missing." >&2
        show_help
        exit 1
      fi
      ;;
    -h|--help)
      HELP_FLAG=1
      shift
      ;;
    -*)
      echo "Error: Unknown option '$1'" >&2
      show_help
      exit 1
      ;;
    *) 
      echo "Error: Unexpected argument '$1'" >&2
      show_help
      exit 1
      ;;
  esac
done

if [[ "$HELP_FLAG" -eq 1 ]]; then
  show_help
  exit 0
fi

if [[ -z "$PERSONA_FILE_ARG" ]]; then
  echo "Error: The persona file is required. Use -p or --persona-file." >&2
  show_help
  exit 1
fi

GUILE_COMMAND="guile -L \"$GUILE_CODE_LOCATION\" -c '((@(iter-vitae main) main))'"

if [[ -n "$LOCALE_ARG" ]]; then
  GUILE_COMMAND+=" $LOCALE_ARG"
fi

if [[ -n "$OUTPUT_DIR_ARG" ]]; then 
  GUILE_COMMAND+=" $OUTPUT_DIR_ARG"
fi

GUILE_COMMAND+=" $PERSONA_FILE_ARG"
GUILE_COMMAND+=" --resources-dir \"$RESOURCES_LOCATION\""

echo "$GUILE_COMMAND"
eval "$GUILE_COMMAND"
