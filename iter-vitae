# Commentary:
#
# This script provides a convenient and user-friendly wrapper
# around the command-line usage of `iter-vitae`, allowing the
# Guile Scheme application to behave and feel like any other
# executable or binary that users may install to their systems.
#
# This also helps installing `iter-vitae` in a convenient fashion
# to the Guix store and it allows us to decouple the user-facing
# command-line interface from the internal Guile Scheme arguments
# to the main program and library.

set -euo pipefail

SCHEME_SOURCES_DIR="$(dirname "$0")/../share/guile/site/3.0"
RESOURCES_DIR="$(dirname "$0")/../share/resources"

show-help() {
    cat "$RESOURCES_DIR/help.txt"
}

LOCALE=""
OUTPUT_DIR=""
PERSONA_FILE=""
HELP_REQUESTED=0

PARSED_OPTIONS=$(getopt -n "iter-vitae" -o l:o:p:h --long locale:,output-dir:,persona-file:,help -- "$@")

eval set -- "$PARSED_OPTIONS"

while true; do
  case "$1" in
    -l|--locale)
      LOCALE="$2"
      shift 2
      ;;
    -o|--output-dir)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -p|--persona-file)
      PERSONA_FILE="$2"
      shift 2
      ;;
    -h|--help)
      show-help
      exit 0
      ;;
    --) 
      shift
      break
      ;;
    *)
      echo "Internal error: unrecognized option '$1'" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$PERSONA_FILE" ]]; then
  echo "Error: The persona file is required. Use -p or --persona-file." >&2
  show-help
  exit 1
fi

GUILE_CMD_ARGS=(
  "-L" "$SCHEME_SOURCES_DIR"
  "-c" "((@(iter-vitae main) main))"
)

[[ -n "$LOCALE" ]] && GUILE_CMD_ARGS+=("--locale" "$LOCALE")
[[ -n "$OUTPUT_DIR" ]] && GUILE_CMD_ARGS+=("--output-dir" "$OUTPUT_DIR")

GUILE_CMD_ARGS+=("--persona-file" "$PERSONA_FILE")
GUILE_CMD_ARGS+=("--resources-dir" "$RESOURCES_DIR")

echo "Running Guile command: guile ${GUILE_CMD_ARGS[*]}"
exec guile "${GUILE_CMD_ARGS[@]}"
