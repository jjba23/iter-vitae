pkgname=iter-vitae
pkgver=1.0.2
pkgrel=1
pkgdesc="Resume and curriculum vitae generator written in Guile Scheme"
arch=('any')
url="https://codeberg.org/jjba23/iter-vitae"
license=('MIT')

depends=(
  'guile'
  'bash'
  'coreutils'
  'guile-lib'
)

makedepends=(
  'guile'
  'pkgconf'
)

checkdepends=(
  'veritas'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('794b3b54e7fd379f4db057df82f6dc7a5b62fee915366be9d634eb18e2162eaa')

# veritas is produced by the same packaging batch; build it first.

# Upstream reads resources from the generic share/resources; several of
# these packages would clash there, so it moves under share/iter-vitae/.

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/iter-vitae"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/iter-vitae"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/iter-vitae -name '*.scm')
}

check() {
  cd "$srcdir/iter-vitae"

  VERITAS_TEST_TYPE=unit VERITAS_RUN_BENCHMARKS=false guile --fresh-auto-compile -L ./src -L ./test -c '((@ (veritas runner) run-tests))'
}

package() {
  cd "$srcdir/iter-vitae"

  # The launcher resolves its modules and resources relative to its
  # own prefix, so the installed layout below is what it expects.
  install -Dm755 scripts/iter-vitae "$pkgdir/usr/bin/iter-vitae"
  sed -i 's|share/resources|share/iter-vitae/resources|g' "$pkgdir/usr/bin/iter-vitae"

  site_dir="$(_site_dir)"
  install -d "$pkgdir${site_dir}/iter-vitae"
  cp -r src/iter-vitae/. "$pkgdir${site_dir}/iter-vitae/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/iter-vitae"
  cp -r "$srcdir/ccache/iter-vitae/." "$pkgdir${ccache_dir}/iter-vitae/"

  install -d "$pkgdir/usr/share/iter-vitae/resources"
  cp -r resources/. "$pkgdir/usr/share/iter-vitae/resources/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 NEWS.org "$pkgdir/usr/share/doc/$pkgname/NEWS.org"
}
