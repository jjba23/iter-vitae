#!/usr/bin/make -f

# iter-vitae
#
# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

export DH_VERBOSE = 1

GUILE_VER = 3.0
SITE_DIR = debian/iter-vitae/usr/share/guile/site/$(GUILE_VER)
BUILD_SITE = build/site
BUILD_CCACHE = build/ccache
# Debian's site-ccache lives in the multiarch libdir; ask Guile's
# pkg-config file instead of hard-coding a path that would be wrong
# on the next architecture.
CCACHE_DIR = $(shell pkg-config --variable=siteccachedir guile-3.0)

%:
	dh $@

# Guile's .go files are ELF objects whose debug sections dwz does
# not understand; there is no separate debug binary to compress.
override_dh_dwz:

override_dh_auto_configure:
	# Nothing to configure: Scheme sources plus (for applications) a
	# POSIX sh launcher, installed by hand below.

override_dh_auto_build:
	mkdir -p $(BUILD_SITE)/iter-vitae $(BUILD_CCACHE)/iter-vitae
	cp -r src/iter-vitae/. $(BUILD_SITE)/iter-vitae/

	# Byte-compile every module so that loading it does not compile it
	# again on first use.
	find $(BUILD_SITE)/iter-vitae -name '*.scm' | while read -r scm_file; do \
		rel_path="$${scm_file#$(BUILD_SITE)/}"; \
		go_file="$(BUILD_CCACHE)/$${rel_path%.scm}.go"; \
		mkdir -p "$$(dirname "$$go_file")"; \
		guild compile -L $(BUILD_SITE) -o "$$go_file" "$$scm_file"; \
	done

override_dh_auto_test:
	VERITAS_TEST_TYPE=unit VERITAS_RUN_BENCHMARKS=false guile --fresh-auto-compile -L ./src -L ./test -c '((@ (veritas runner) run-tests))'

override_dh_auto_install:
	# Launcher.  It resolves its modules and resources relative to
	# its own prefix, so it is installed next to the site directory.
	install -Dm 0755 scripts/iter-vitae debian/iter-vitae/usr/bin/iter-vitae
	# Upstream reads resources from the generic share/resources; several of
	# these packages would clash there, so it moves under share/iter-vitae/.
	sed -i 's|share/resources|share/iter-vitae/resources|g' debian/iter-vitae/usr/bin/iter-vitae

	# Scheme sources and their byte-compiled copies.
	mkdir -p $(SITE_DIR) debian/iter-vitae$(CCACHE_DIR)
	cp -r $(BUILD_SITE)/iter-vitae $(SITE_DIR)/
	cp -r $(BUILD_CCACHE)/iter-vitae debian/iter-vitae$(CCACHE_DIR)/

	# Resources the launcher passes to the program: help text and,
	# depending on the project, templates, themes or migrations.
	mkdir -p debian/iter-vitae/usr/share/iter-vitae/resources
	cp -r resources/. debian/iter-vitae/usr/share/iter-vitae/resources/

override_dh_auto_clean:
	rm -rf build
	dh_auto_clean
